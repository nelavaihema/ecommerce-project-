# ---------------------------------------------------------------------------
# DS Wardrobe - Medusa backend environment
# Copy to .env and fill in. NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------
NODE_ENV=development

# PostgreSQL connection string (docker compose / tools/dev-db default shown)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ds_wardrobe

# Redis. Optional in development (in-memory fallbacks are used when unset).
# REQUIRED in production for the event bus, workflow engine, cache and locking.
# REDIS_URL=redis://localhost:6379

# CORS - comma-separated origins
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Secrets - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# Public URLs
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# Razorpay payment provider (optional). When both keys are set the provider
# "pp_razorpay_razorpay" is registered; enable it on the India region in admin
# (or re-run the seed). Use TEST keys (rzp_test_...) for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Object storage for product images in production (S3 / R2 / Spaces). When
# S3_BUCKET is set the S3 file provider replaces local file storage.
# S3_FILE_URL=https://cdn.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-south-1
# S3_BUCKET=
# S3_ENDPOINT=
